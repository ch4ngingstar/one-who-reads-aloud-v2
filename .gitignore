# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ─── Node / Next.js ───────────────────────────────────────
ui/node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
ui/tsconfig.tsbuildinfo
*.tsbuildinfo

# ─── External dependencies (cloned/downloaded separately) ──
# Fish Speech is a nested git repo cloned per CLAUDE.md setup
fish-speech/
# IndexTTS2 is a nested git repo (clone + ~8 GB weights) installed per CLAUDE.md;
# its 4 local patches (pyproject.toml, infer_v2.py) are documented in memory, not here.
index-tts/
# GGUF model weights — multi-GB, downloaded separately
models/

# ─── Runtime data (generated by the pipeline) ─────────────
# data/* (not data/) so git can still descend for the sound-design negations below.
data/*
src/data/
logs/
*.db
*.sqlite
*.sqlite3

# Sound-design catalogue + library layout — track the manifest and the empty
# category dirs, but NOT the audio clips themselves (those stay ignored, and
# *.wav/*.mp3 below also catch them).
!data/sfx/
data/sfx/*
!data/sfx/manifest.json
!data/sfx/ambience/
!data/sfx/music/
!data/sfx/sfx/
data/sfx/ambience/*
data/sfx/music/*
data/sfx/sfx/*
!data/sfx/ambience/.gitkeep
!data/sfx/music/.gitkeep
!data/sfx/sfx/.gitkeep

# ─── Generated audio ──────────────────────────────────────
*.wav
*.mp3

# ─── Debug / tooling artifacts ────────────────────────────
.playwright-mcp/
.mypy_cache/
.ruff_cache/
*.log
.superpowers/
# Local eval/measurement outputs (the eval harness itself was removed for a
# clean end-user repo; these are scratch result files, kept on disk only)
docs/eval_*.csv
docs/eval_*.json

# ─── Screenshots & scratch images (root-level captures) ───
*.png
!docs/screenshots/*.png

# ─── OS / editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ─── Claude Code project instructions (kept local, not published) ──
CLAUDE.md
