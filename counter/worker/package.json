    "preview": "vite-node scripts/preview.ts"
  },
  "devDependencies": {
    "wrangler": "4.168.0",
    "vitest": "3.2.4",
    "typescript": "5.9.3",
    "@cloudflare/workers-types": "5.20261123.1"
  }
}
